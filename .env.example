# ─── EduSphere Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values for local dev.
# On Render, set these in the Dashboard → Environment section.

# ── Backend (server/index.js) ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Secret key for JWT token signing — use a long random string
JWT_SECRET=your-super-secret-jwt-key-here

# URL of the deployed frontend (e.g. https://edusphere-frontend.onrender.com)
FRONTEND_URL=https://your-frontend.onrender.com

# URL of the deployed ML service (e.g. https://edusphere-ml.onrender.com)
ML_SERVICE_URL=https://your-ml-service.onrender.com

# Path to SQLite database — on Render, use the mounted disk path
DB_PATH=/var/data/edusphere.db

# ── ML Service (ml-service/config.py) ────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://your-frontend.onrender.com

# Secret key for ML service auth
ML_SECRET=your-ml-service-secret-here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL of the deployed backend API (e.g. https://edusphere-api.onrender.com)
VITE_API_URL=https://your-api.onrender.com
